rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ─────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'thejestamang@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // A member is a real account (Google or email). Anonymous sign-in exists only so
    // guests can save game scores; it must never unlock member features.
    function isMember() {
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isMember() && request.auth.uid == uid;
    }

    // ── ADMIN WILDCARD — full access to everything ────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }


    // ── PUBLIC CONTENT COLLECTIONS ───────────────────────────────────────────
    // These power public-facing pages and must be readable without auth.

    match /lyrics/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /releases/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /albumSections/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /photos/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /entities/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /videos/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /pressArticles/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /merch/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /sigilCards/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /navBadges/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }


    // ── LEADERBOARDS & SCORES ────────────────────────────────────────────────
    match /leaderboards/{entryId} {
      // Validate exactly what the games send: game, name, score, uid, photoURL,
      // timestamp (serverTimestamp), and Memory Vault's boolean `flawless`.
      allow read:   if true;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['game','name','score','uid','timestamp'])
                    && request.resource.data.keys().hasOnly(['game','name','score','uid','photoURL','timestamp','flawless'])
                    && request.resource.data.game is string
                    && request.resource.data.game.size() > 0
                    && request.resource.data.game.size() <= 40
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 10000000
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.timestamp == request.time
                    && (!('photoURL' in request.resource.data)
                        || request.resource.data.photoURL == null
                        || (request.resource.data.photoURL is string
                            && request.resource.data.photoURL.size() <= 500))
                    && (!('flawless' in request.resource.data)
                        || request.resource.data.flawless is bool);
      allow update: if false;
      // A player may delete their own rows (account deletion on profile.html); admin may delete any.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /scores/{entryId} {
      allow read:   if true;
      allow create: if isMember();
      allow update: if false;
      allow delete: if isAdmin();
    }


    // ── COMMENTS ─────────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read:   if true;
      allow create: if isMember();
      allow update: if false;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }


    // ── BLOG POSTS ───────────────────────────────────────────────────────────
    match /blogPosts/{postId} {
      allow read:  if true;
      allow write: if isAdmin();
    }


    // ── SHOWS ────────────────────────────────────────────────────────────────
    match /shows/{showId} {
      allow read:  if true;
      allow write: if isAdmin();
    }


    // ── GUESTBOOK ────────────────────────────────────────────────────────────
    match /guestbook/{userId} {
      allow read:   if true;
      allow create: if isMember()
                    && request.auth.uid == userId
                    && !exists(/databases/$(database)/documents/guestbook/$(request.auth.uid));
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }


    // ── INNER CIRCLE CHAT ────────────────────────────────────────────────────
    // Each message is written by its own sender (uid must be the caller), with the fields
    // members.html writes and nothing else; the 500-character limit is enforced here, not
    // only in the browser. The photo is the sender's avatar (a URL or a small data URL).
    match /innerCircleChat/{messageId} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','name','photo','text','ts'])
                    && request.resource.data.keys().hasAll(['uid','name','text','ts'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && (!('photo' in request.resource.data)
                        || (request.resource.data.photo is string && request.resource.data.photo.size() <= 150000))
                    && request.resource.data.ts == request.time;
      allow update: if false;
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }


    // ── USERS ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/natalChart/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── PUBLIC CHARTS (opt-in dossier sharing) ───────────────────────────────
    // Written by the owner from profile.html "Copy Dossier Link" and read by
    // dossier.html?user=<uid>. Holds only the rendered chart. The field
    // allowlist makes it impossible to publish birthDate/birthTime/birthPlace/
    // lat/lng here, and the private natalChart and users docs stay owner-only.
    match /publicCharts/{userId} {
      allow read:   if true;
      allow create, update: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['planets','ascendant','mc','houseCusps','elements','modes','aspects','hasTime','name','sharedAt'])
                    && request.resource.data.keys().hasAll(['planets','name','sharedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.sharedAt == request.time;
      allow delete: if isOwner(userId) || isAdmin();
    }


    // ── TREATS ───────────────────────────────────────────────────────────────
    match /treats/{docId} {
      allow read:  if isMember();
      allow write: if isAdmin();
    }


    // ── MEMBER UPDATES (members-only writings) ───────────────────────────────
    // Members read published writings only; drafts stay admin-only. A member query must
    // therefore carry where('published', '==', true) (members.html does).
    match /membersUpdates/{docId} {
      allow read:  if isAdmin() || (isMember() && resource.data.published == true);
      allow write: if isAdmin();
    }


    // ── FAVORITES ────────────────────────────────────────────────────────────
    // Flat collection with auto IDs; the owner is recorded in `userId`
    // (albums.html and profile.html query .where('userId','==',uid)).
    match /favorites/{docId} {
      allow read:   if isMember() && resource.data.userId == request.auth.uid;
      allow create: if isMember()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['userId','songTitle','artist','album','savedAt'])
                    && request.resource.data.songTitle is string
                    && request.resource.data.songTitle.size() <= 200
                    && request.resource.data.artist is string
                    && request.resource.data.artist.size() <= 200;
      allow update: if false;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }


    // ── INQUIRIES ────────────────────────────────────────────────────────────
    // Anyone may send an inquiry (merch.html "Ask a Question"), but only in the shape that
    // form writes, with length caps, a plausible email, status 'new' and the server time.
    match /inquiries/{inquiryId} {
      allow read, write: if isAdmin();
      allow create:      if request.resource.data.keys().hasOnly(['name','email','item','message','timestamp','status'])
                         && request.resource.data.keys().hasAll(['name','email','message','timestamp','status'])
                         && request.resource.data.name is string
                         && request.resource.data.name.size() >= 1
                         && request.resource.data.name.size() <= 100
                         && request.resource.data.email is string
                         && request.resource.data.email.size() <= 254
                         && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                         && (!('item' in request.resource.data)
                             || (request.resource.data.item is string && request.resource.data.item.size() <= 120))
                         && request.resource.data.message is string
                         && request.resource.data.message.size() >= 1
                         && request.resource.data.message.size() <= 2000
                         && request.resource.data.status == 'new'
                         && request.resource.data.timestamp == request.time;
    }


    // ── NOTIFICATIONS (transmissions) ────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:           if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isMember()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['seen']));
    }


    // ── EMAIL CAMPAIGNS ──────────────────────────────────────────────────────
    match /emailCampaigns/{docId} {
      allow read, write: if isAdmin();
    }

  }
}
